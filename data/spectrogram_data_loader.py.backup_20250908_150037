            'geng220': 0,  # 油层
            'geng221': 3,  # 差油层 (根据实际解释结论，差油层占多数)
            'geng343': 2,  # 干层
            'geng60': 2,   # 干层
            'geng86': 3,   # 差油层
            
            # Ji系列井 (3口)
            'ji117': 4,    # 油水同层
            'ji121': 1,    # 水层
            'jian39': 3,   # 差油层
            
            # 其他井 (4口)
            'di199-48': 0, # 油层 (根据实际解释结论，油层占多数)
            'di200-47': 3, # 差油层 (根据实际解释结论，差油层占多数)
            'luo160': 2,   # 干层
